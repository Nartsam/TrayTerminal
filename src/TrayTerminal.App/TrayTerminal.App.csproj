<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TrayTerminal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrayTerminal.Shared\TrayTerminal.Shared.csproj" />
    <ProjectReference Include="..\TrayTerminal.Host\TrayTerminal.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Vendored npm files retain their upstream timestamps, which can be older
         than stale build output. Always replace this pinned, version-coupled set. -->
    <Content Update="Assets\xterm\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyHostOutput" AfterTargets="Build">
    <ItemGroup>
      <HostOutputFiles Include="..\TrayTerminal.Host\$(OutputPath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(HostOutputFiles)"
          DestinationFiles="@(HostOutputFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
