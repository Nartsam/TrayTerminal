<Window x:Class="TrayTerminal.App.Dialogs.RenameTabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名标签"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="标签名称"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,6" />
        <TextBox x:Name="TitleTextBox"
                 Grid.Row="1"
                 Height="32" />
        <!-- Keeps its height when empty so a message does not resize the window. -->
        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   MinHeight="18"
                   Margin="0,6,0,10"
                   Foreground="{StaticResource StatusWarningBrush}"
                   FontSize="12" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="OkButton"
                    Content="确定"
                    Width="88"
                    Height="32"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
